# ==============================================================================
# CHATBOT SAAS ENVIRONMENT CONFIGURATION
# Stack: GitHub + Vercel + Neon PostgreSQL
# Zero-cost MVP architecture
# ==============================================================================

# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Security & Session Secrets (Generate with `openssl rand -hex 32` or node crypto)
SESSION_SECRET="replace-with-a-cryptographically-secure-random-64-character-secret"
PASSWORD_RESET_SECRET="replace-with-a-cryptographically-secure-random-64-character-secret"

# Initial Super Admin Bootstrap (Used only for first initialization)
ADMIN_BOOTSTRAP_EMAIL="admin@platform.local"
ADMIN_BOOTSTRAP_PASSWORD="YourStrongSuperAdminPassword2026!#"

# Application URL
APP_URL="http://localhost:3000"

# Email Provider Configuration (console for ₹0 local development, smtp for production)
EMAIL_PROVIDER="console" # Options: console, smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="support@yourcompany.com"
SMTP_FROM_NAME="Chatbot SaaS Platform"

# Storage & AI Configuration (Optional, zero-cost defaults)
STORAGE_MODE="local"
AI_PROVIDER="disabled" # Options: disabled, ollama, groq, openrouter, gemini
OLLAMA_BASE_URL="http://localhost:11434"
