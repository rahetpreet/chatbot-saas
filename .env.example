# =============================================================================
# CHATBOT SaaS - ENVIRONMENT CONFIGURATION
# Stack: GitHub + Vercel + Neon PostgreSQL. Zero mandatory paid services.
#
# Local development:  copy to .env and fill in.
# Production:         set these in Vercel (Project -> Settings -> Environment
#                     Variables), then redeploy so the build picks them up.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (required)
# -----------------------------------------------------------------------------
# DATABASE_URL is the POOLED Neon endpoint (the host contains "-pooler").
# pgbouncer=true is REQUIRED: without it Prisma's prepared statements collide
# on PgBouncer's transaction pooling and interactive transactions fail
# intermittently with 'prepared statement "s0" already exists'.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# DIRECT_URL is the NON-pooled endpoint (same host, without "-pooler").
# Prisma Migrate needs a direct connection; migrate deploy fails without it.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# APPLICATION URL (required)
# -----------------------------------------------------------------------------
# Used to build password-reset links. The request Host header is deliberately
# never trusted for this. On Vercel, VERCEL_URL is used as a fallback.
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# SUPER ADMIN BOOTSTRAP (required for first setup only)
# -----------------------------------------------------------------------------
# Read only by `prisma db seed`, and only when no SUPER_ADMIN exists yet.
# Seeding fails loudly if the password is missing; there is no default.
# After first login, change the password in the app. The database is then the
# only source of truth and this variable stops having any effect.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# -----------------------------------------------------------------------------
# EMAIL
# -----------------------------------------------------------------------------
# "console" records messages to the DevEmail table and the server log, viewable
# at /dev/email-inbox in development. Use "smtp" in production.
EMAIL_PROVIDER="console"

# Gmail: enable 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and use it as SMTP_PASSWORD.
# Your normal Google password will not work.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Chatbot SaaS"

# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
# "local" writes to public/uploads and is DEVELOPMENT ONLY: Vercel's filesystem
# is read-only outside /tmp, so uploads there fail. Production must use "blob".
# Create a Blob store in the Vercel dashboard (Storage -> Blob); Vercel injects
# BLOB_READ_WRITE_TOKEN automatically once it is connected to the project.
STORAGE_PROVIDER="local"

# -----------------------------------------------------------------------------
# AI (optional - the product works fully with AI disabled)
# -----------------------------------------------------------------------------
# "disabled" makes AI nodes fall back gracefully. Ollama is for local use only;
# do not point this at localhost in production.
AI_PROVIDER="disabled"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# -----------------------------------------------------------------------------
# TESTING (optional)
# -----------------------------------------------------------------------------
# Point at a scratch database (a Neon branch works well) to enable the
# tenant-isolation integration tests. They are skipped when this is unset.
TEST_DATABASE_URL=""

# =============================================================================
# NOTE: SESSION_SECRET, PASSWORD_RESET_SECRET and JWT_SECRET are NOT used.
# Sessions are opaque 32-byte random tokens stored as SHA-256 hashes in the
# Session table, so no signing secret is required. Earlier docs listed these;
# they can be removed from your Vercel project.
# =============================================================================
