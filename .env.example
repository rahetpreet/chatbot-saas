# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/chatbot_saas?schema=public"

# App & Authentication
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="dev-super-secure-jwt-secret-key-32-chars-long-chatbot-saas"
APP_MODE="development"

# Free-First Service Providers Configuration
# Storage: "local" (default, free) or "s3"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./public/uploads"

# Email: "console" (free dev mode: logs links to dev inbox) or "smtp"
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@chatbotsaas.local"

# AI Provider: "disabled" (pure rule-based flow), "ollama" (local free LLM), or "external" (free API tiers)
AI_PROVIDER="disabled"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
EXTERNAL_AI_API_KEY=""
EXTERNAL_AI_PROVIDER="groq" # or gemini, openrouter
