# =============================================================================
# PRODUCTION VALUES FOR VERCEL
#
# Copy this file to `.env.vercel`, fill in the two blanks marked TODO, then run:
#
#     node scripts/sync-vercel-env.mjs            (shows what it would do)
#     node scripts/sync-vercel-env.mjs --apply    (actually pushes)
#
# This file is for your LIVE site. `.env` stays as your local settings.
# Neither file is ever committed to GitHub.
# =============================================================================


# --- Your live website address -----------------------------------------------
# This is what password-reset emails and campaign tracking links point at.
# Change it here if you later connect your own domain.
APP_URL="https://chatbot-saas-peach.vercel.app"
NEXT_PUBLIC_APP_URL="https://chatbot-saas-peach.vercel.app"


# --- AI --------------------------------------------------------------------
# TODO: paste your free Google AI key below.
# Get one at https://aistudio.google.com/apikey  (sign in, click "Create API key")
# Leave AI_API_KEY empty to keep AI switched off; everything else still works.
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL=""


# --- AI backup providers (recommended) ---------------------------------------
# Free tiers go busy. When the primary provider is unavailable the app falls
# back to a keyword template, which produces a generic flow. A second key makes
# that a non-event -- generation just uses whichever provider answers.
#
# TODO: paste a free Groq key below. https://console.groq.com/keys
# (Sign in with Google, click "Create API Key", copy it. Takes a minute.)
GROQ_API_KEY=""

# Optional third provider. https://openrouter.ai/keys
OPENROUTER_API_KEY=""


# --- File uploads ------------------------------------------------------------
# Requires a Blob store: Vercel dashboard -> Storage -> Blob -> Create,
# then connect it to this project. Vercel adds the access token by itself.
STORAGE_PROVIDER="blob"


# --- Email -------------------------------------------------------------------
# TODO: paste a Gmail App Password below (NOT your normal Google password).
# Google Account -> Security -> 2-Step Verification -> App passwords -> Mail.
# Leave SMTP_PASSWORD empty to keep emails switched off for now.
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="rahetpreet27@gmail.com"
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="rahetpreet27@gmail.com"
SMTP_FROM_NAME="Adfinmark Chat"
