{
  "name": "nocode-chatbot-saas",
  "version": "1.0.0",
  "private": true,
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && node --require ./patch-node24.cjs ./node_modules/next/dist/bin/next build --webpack",
