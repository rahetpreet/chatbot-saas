datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  status              String   @default("ACTIVE") // ACTIVE, PAUSED, SUSPENDED, TERMINATED
  planTier            String   @default("STARTER") // FREE, STARTER, PRO, ENTERPRISE
  maxMessagesPerMonth Int      @default(5000)
  maxFlows            Int      @default(5)
  maxCampaignLinks    Int      @default(50)
  maxStorageMb        Int      @default(100)
  customSmtpConfig    String?  // JSON string: host, port, user, pass, secure, from
  aiConfig            String?  // JSON string: enabled, provider, model, apiKey, systemPrompt, temperature
  widgetSettings      String?  // JSON string: primaryColor, secondaryColor, position, launcherStyle, title, subtitle, greeting, avatar, soundEnabled, allowedDomains
  branding            String?  // JSON string: logoUrl, customDomain
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users            User[]
  flows            Flow[]
  campaigns        Campaign[]
  campaignContacts CampaignContact[]
  conversations    Conversation[]
  leads            Lead[]
  analyticsEvents  AnalyticsEvent[]
  auditLogs        AuditLog[]
  knowledgeDocs    KnowledgeDoc[]

  @@index([slug])
  @@index([status])
}

model User {
  id                 String    @id @default(cuid())
  tenantId           String?   // NULL for superadmin
  role               String    @default("CLIENT_ADMIN") // SUPER_ADMIN, CLIENT_ADMIN, AGENT
  email              String    @unique
  name               String
  passwordHash       String
  status             String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  resetToken         String?
  resetTokenExpires  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs          AuditLog[]

  @@index([tenantId])
  @@index([email])
}

model Flow {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  version         Int      @default(1)
  status          String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  isDefault       Boolean  @default(false)
  nodes           String   @default("[]") // JSON string of ReactFlow nodes
  edges           String   @default("[]") // JSON string of ReactFlow edges
  publishedNodes  String?  // JSON string snapshot
  publishedEdges  String?  // JSON string snapshot
  triggers        String?  // JSON string: onWidgetOpen, delaySeconds, urlPatterns
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  analyticsEvents AnalyticsEvent[]

  @@index([tenantId])
  @@index([status])
}

model Campaign {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  slug             String
  flowId           String?
  metadata         String?  // JSON string: utmSource, utmMedium, tags
  opensCount       Int      @default(0)
  conversionsCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts         CampaignContact[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model CampaignContact {
  id                String    @id @default(cuid())
  campaignId        String
  tenantId          String
  contactIdentifier String
  name              String?
  email             String?
  phone             String?
  customUrlSlug     String    @unique
  metadata          String?   // JSON string
  opensCount        Int       @default(0)
  firstOpenedAt     DateTime?
  lastOpenedAt      DateTime?
  status            String    @default("PENDING") // PENDING, OPENED, COMPLETED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign          Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations     Conversation[]

  @@index([tenantId])
  @@index([campaignId])
  @@index([customUrlSlug])
}

model Conversation {
  id                String    @id @default(cuid())
  tenantId          String
  flowId            String?
  campaignContactId String?
  visitorId         String
  sessionStatus     String    @default("ACTIVE") // ACTIVE, HANDOVER, RESOLVED, ABANDONED
  visitorInfo       String?   // JSON string: ip, browser, os, device, country, referrer, utm
  collectedData     String?   @default("{}") // JSON string
  currentNodeId     String?
  startedAt         DateTime  @default(now())
  lastActiveAt      DateTime  @default(now())
  closedAt          DateTime?

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flow              Flow?             @relation(fields: [flowId], references: [id], onDelete: SetNull)
  campaignContact   CampaignContact?  @relation(fields: [campaignContactId], references: [id], onDelete: SetNull)
  messages          Message[]
  leads             Lead[]
  analyticsEvents   AnalyticsEvent[]

  @@index([tenantId])
  @@index([sessionStatus])
  @@index([visitorId])
  @@index([flowId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderType     String   // BOT, VISITOR, AI, AGENT
  senderName     String?
  content        String
  attachments    String?  // JSON string: array of { url, name, size, type }
  nodeId         String?
  timestamp      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([timestamp])
}

model Lead {
  id              String   @id @default(cuid())
  tenantId        String
  conversationId  String?
  name            String?
  email           String?
  phone           String?
  contactInfo     String?  // JSON string
  collectedFields String?  // JSON string
  score           Int      @default(0)
  status          String   @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  category  String?
  content   String
  embedding String?  // JSON or text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AnalyticsEvent {
  id             String   @id @default(cuid())
  tenantId       String
  flowId         String?
  conversationId String?
  eventType      String   // SESSION_START, NODE_VIEW, NODE_SUBMIT, BUTTON_CLICK, CAMPAIGN_OPEN, CONVERSION, HANDOVER_REQUEST
  nodeId         String?
  metadata       String?  // JSON string
  timestamp      DateTime @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flow           Flow?         @relation(fields: [flowId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([eventType])
  @@index([timestamp])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  details   String?  // JSON string
  ipAddress String?
  timestamp DateTime @default(now())

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
}

model DevEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String
  text      String
  resetLink String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
