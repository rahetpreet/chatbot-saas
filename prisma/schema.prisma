datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// prisma db seed executes this script; bootstrap creation is idempotent.

model Tenant {
  id                     String    @id @default(cuid())
  name                   String
  slug                   String    @unique
  status                 String    @default("ACTIVE") // TRIAL, ACTIVE, PAUSED, EXPIRED, CANCELLED
  planTier               String    @default("STARTER") // FREE, STARTER, PRO, ENTERPRISE
  website                String?
  industry               String?
  logoUrl                String?
  maxMessagesPerMonth    Int       @default(5000)
  maxFlows               Int       @default(5)
  maxCampaignLinks       Int       @default(50)
  maxStorageMb           Int       @default(100)
  customSmtpConfig       String? // JSON string: host, port, user, pass, secure, from
  aiConfig               String? // JSON string: enabled, provider, model, apiKey, systemPrompt, temperature
  widgetSettings         String? // JSON string: primaryColor, secondaryColor, position, launcherStyle, title, subtitle, greeting, avatar, soundEnabled, allowedDomains
  branding               String? // JSON string: logoUrl, customDomain
  timezone               String    @default("UTC")
  /// Fully-qualified host serving this workspace's chat, e.g. "chat.acme.com".
  /// Matched against the request Host header; unique across the platform
  /// because one hostname can only route to one workspace.
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  users            User[]
  memberships      TenantUser[]
  sessions         Session[]
  flows            Flow[]
  campaigns        Campaign[]
  campaignContacts CampaignContact[]
  conversations    Conversation[]
  leads            Lead[]
  analyticsEvents  AnalyticsEvent[]
  auditLogs        AuditLog[]
  knowledgeDocs    KnowledgeDoc[]
  subscriptions    Subscription[]
  contacts         Contact[]
  chatbots         Chatbot[]
  attachments      Attachment[]
  webhooks         Webhook[]
  apiKeys          ApiKey[]
  usageRecords     UsageRecord[]
  exportJobs       ExportJob[]
  visitors         Visitor[]
  trackingLinks    TrackingLink[]
  notifications    Notification[]
  shortLinks       ShortLink[]

  notificationSetting NotificationSetting?

  pushSubscriptions   PushSubscription[]

  reportSnapshots  ReportSnapshot[]

  dailyAnalytics   DailyAnalytics[]


  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@index([planTier])
  @@index([createdAt])
}

model User {
  id                     String    @id @default(cuid())
  tenantId               String? // NULL for superadmin
  role                   String    @default("CLIENT_ADMIN") // SUPER_ADMIN, CLIENT_OWNER, CLIENT_ADMIN, CLIENT_AGENT, CLIENT_VIEWER
  email                  String    @unique
  name                   String
  passwordHash           String
  status                 String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  isActive               Boolean   @default(true)
  mustChangePassword     Boolean   @default(false)
  lastLoginAt            DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions            Session[]
  auditLogs           AuditLog[]
  memberships         TenantUser[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]

  @@index([tenantId])
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@index([isActive])
  @@index([deletedAt])
  @@index([tenantId, isActive])
  @@index([tenantId, role])
  @@index([lastLoginAt])
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  tenantId             String?
  tokenHash            String   @unique
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  lastSeenAt           DateTime @default(now())
  ipAddress            String?
  userAgent            String?
  impersonatedByUserId String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String   @default("CLIENT_ADMIN")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  features      PlanFeature[]
  subscriptions Subscription[]
}

model PlanFeature {
  id      String  @id @default(cuid())
  planId  String
  key     String
  value   Int?
  enabled Boolean @default(true)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Subscription {
  id        String    @id @default(cuid())
  tenantId  String
  planId    String
  status    String    @default("ACTIVE")
  startedAt DateTime  @default(now())
  endsAt    DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@index([tenantId, status])
}

model Contact {
  id            String         @id @default(cuid())
  tenantId      String
  name          String?
  email         String?
  phone         String?
  company       String?
  designation   String?
  location      String?
  source        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads         Lead[]
  trackingLinks TrackingLink[]

  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, deletedAt])
  @@index([tenantId, createdAt])
}

model Chatbot {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  publicId    String           @unique @default(cuid())
  description String?
  status      String           @default("DRAFT")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions    ChatbotVersion[]

  @@index([tenantId, status])
}

model ChatbotVersion {
  id            String    @id @default(cuid())
  chatbotId     String
  versionNumber Int
  status        String    @default("DRAFT")
  configJson    String    @default("{}")
  createdBy     String?
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  chatbot       Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  @@unique([chatbotId, versionNumber])
  @@index([chatbotId, status])
}

model Flow {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  version        Int       @default(1)
  status         String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  isDefault      Boolean   @default(false)
  nodes          String    @default("[]") // JSON string of ReactFlow nodes
  edges          String    @default("[]") // JSON string of ReactFlow edges
  publishedNodes String? // JSON string snapshot
  publishedEdges String? // JSON string snapshot
  triggers       String? // JSON string: onWidgetOpen, delaySeconds, urlPatterns
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  analyticsEvents AnalyticsEvent[]

  trackingLinks TrackingLink[]

  @@index([tenantId])
  @@index([status])
  @@index([deletedAt])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
}

model Campaign {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  slug             String
  flowId           String?
  metadata         String? // JSON string: utmSource, utmMedium, tags
  opensCount       Int       @default(0)
  conversionsCount Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts      CampaignContact[]
  conversations Conversation[]
  leads         Lead[]
  trackingLinks TrackingLink[]
  shortLinks    ShortLink[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([deletedAt])
}

model CampaignContact {
  id                String    @id @default(cuid())
  campaignId        String
  tenantId          String
  contactIdentifier String
  name              String?
  email             String?
  phone             String?
  customUrlSlug     String    @unique
  metadata          String? // JSON string
  opensCount        Int       @default(0)
  firstOpenedAt     DateTime?
  lastOpenedAt      DateTime?
  status            String    @default("PENDING") // PENDING, OPENED, COMPLETED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId])
  @@index([campaignId])
  @@index([customUrlSlug])
  @@index([deletedAt])
}

model Conversation {
  id                     String    @id @default(cuid())
  tenantId               String
  flowId                 String?
  /// Version of the flow that served this conversation, captured at start.
  /// Without it, version-over-version comparison silently reinterprets old
  /// conversations through the current flow and every number becomes a guess.
  flowVersion            Int?
  campaignContactId      String?
  campaignId             String?
  trackingLinkId         String?
  visitorRecordId        String?
  visitorId              String
  publicSessionTokenHash String?   @unique
  sessionStatus          String    @default("ACTIVE") // ACTIVE, HANDOVER, RESOLVED, ABANDONED
  visitorInfo            String? // JSON string: ip, browser, os, device, country, referrer, utm
  collectedData          String?   @default("{}") // JSON string
  currentNodeId          String?
  startedAt              DateTime  @default(now())
  lastActiveAt           DateTime  @default(now())
  closedAt               DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flow            Flow?            @relation(fields: [flowId], references: [id], onDelete: SetNull)
  campaignContact CampaignContact? @relation(fields: [campaignContactId], references: [id], onDelete: SetNull)
  campaign        Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  trackingLink    TrackingLink?    @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)
  visitor         Visitor?         @relation(fields: [visitorRecordId], references: [id], onDelete: SetNull)
  messages        Message[]
  leads           Lead[]
  analyticsEvents AnalyticsEvent[]

  @@index([tenantId])
  @@index([sessionStatus])
  @@index([visitorId])
  @@index([flowId])
  @@index([tenantId, sessionStatus])
  @@index([tenantId, lastActiveAt])
  @@index([tenantId, startedAt])
  @@index([publicSessionTokenHash])
  @@index([campaignId])
  @@index([trackingLinkId])
  @@index([visitorRecordId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderType     String // BOT, VISITOR, AI, AGENT
  senderName     String?
  content        String
  attachments    String? // JSON string: array of { url, name, size, type }
  nodeId         String?
  timestamp      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([timestamp])
  @@index([conversationId, timestamp])
  @@index([senderType])
}

model Lead {
  id              String    @id @default(cuid())
  tenantId        String
  conversationId  String?
  contactId       String?
  campaignId      String?
  name            String?
  email           String?
  phone           String?
  contactInfo     String? // JSON string
  collectedFields String? // JSON string
  score           Int       @default(0)
  status          String    @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, ARCHIVED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([contactId])
  @@index([campaignId])
  @@index([status])
  @@index([deletedAt])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, createdAt])
  @@index([conversationId])
}

model KnowledgeDoc {
  id         String   @id @default(cuid())
  tenantId   String
  title      String
  category   String?
  content    String
  embedding  String? // JSON or text
  /// manual | website | file
  sourceType String   @default("manual")
  /// Page the content came from, so it can be re-crawled or cited.
  sourceUrl  String?
  /// Long sources are split, because retrieval works better on passages than
  /// on whole pages and the model has a finite context.
  chunkIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, sourceType])
  @@index([sourceUrl])
}

model AnalyticsEvent {
  id             String   @id @default(cuid())
  tenantId       String
  flowId         String?
  /// The published flow version this event happened on. Reports must never
  /// re-explain old conversations using today's flow, so the version is frozen
  /// onto the event rather than read back from the flow.
  flowVersion    Int?
  conversationId String?
  /// Anonymous visitor id, copied onto the event rather than joined. Visitor
  /// counts are the most-run query in this module and a join per event row
  /// makes them cost far more than they are worth.
  visitorId      String?
  campaignId     String?
  trackingLinkId String?
  contactId      String?
  leadId         String?
  eventType      String
  nodeId         String?
  nodeType       String?
  /// The button or option text, so option distribution is a GROUP BY rather
  /// than a JSON scan over every event's metadata.
  optionLabel    String?
  metadata       String?
  timestamp      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flow         Flow?         @relation(fields: [flowId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // campaignId, trackingLinkId, contactId and leadId are deliberately plain
  // columns with no foreign key. An event is a record that something happened;
  // deleting a campaign must not rewrite history by nulling it out of last
  // quarter's numbers.

  @@index([tenantId])
  @@index([eventType])
  @@index([timestamp])
  @@index([tenantId, eventType])
  @@index([tenantId, timestamp])
  @@index([conversationId])
  @@index([flowId])
  // Every funnel and trend query is "this tenant, these event types, this date
  // range", so that is the shape the main index has to serve.
  @@index([tenantId, eventType, timestamp])
  @@index([tenantId, flowId, nodeId])
  @@index([tenantId, campaignId, timestamp])
  @@index([tenantId, trackingLinkId])
  @@index([tenantId, visitorId])
  @@index([tenantId, leadId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  details   String? // JSON string
  ipAddress String?
  timestamp DateTime @default(now())

  /// SetNull, not Cascade: an audit trail that is destroyed along with the
  /// thing it records is not an audit trail. Removing a workspace previously
  /// deleted every log entry explaining who removed it and why.
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
  @@index([tenantId, timestamp])
  @@index([userId, timestamp])
  @@index([action])
}

model DevEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String
  text      String
  resetLink String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Attachment {
  id               String   @id @default(cuid())
  tenantId         String
  conversationId   String?
  messageId        String?
  contactId        String?
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([storageKey])
}

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String
  event     String
  url       String
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyHash    String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model UsageRecord {
  id        String   @id @default(cuid())
  tenantId  String
  metric    String // "MESSAGES", "FLOWS", "STORAGE_MB", "CAMPAIGN_LINKS"
  quantity  Int      @default(0)
  period    String // "2026-09"
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, period])
  @@index([tenantId])
}

model ExportJob {
  id          String   @id @default(cuid())
  tenantId    String
  type        String // "CONVERSATIONS", "CONTACTS", "LEADS"
  status      String   @default("PENDING") // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  downloadUrl String?
  filters     String? // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Shared rate-limit counters. Vercel gives each lambda its own memory, so an
/// in-process Map provided no real protection: the effective limit was the
/// configured limit multiplied by the number of live instances.
model RateLimitCounter {
  key         String   @id
  windowStart DateTime @default(now())
  count       Int      @default(0)
  expiresAt   DateTime

  @@index([expiresAt])
}

/// A returning anonymous visitor. Conversation.visitorId previously pointed at
/// nothing, so the same person opening the widget twice looked like two
/// unrelated people and no cross-session behaviour could be reported.
model Visitor {
  id           String   @id @default(cuid())
  tenantId     String
  anonymousId  String
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  sessionCount Int      @default(1)
  metadata     String? // JSON string: device, referrer, country

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, anonymousId])
  @@index([tenantId])
  @@index([lastSeenAt])
}

/// A shareable campaign link. The token is cryptographically random and never
/// derived from an email, phone number or row id.
model TrackingLink {
  id                String    @id @default(cuid())
  tenantId          String
  campaignId        String?
  flowId            String?
  contactId         String?
  campaignContactId String?
  token             String    @unique
  firstOpenedAt     DateTime?
  lastOpenedAt      DateTime?
  openCount         Int       @default(0)
  conversationCount Int       @default(0)
  leadGenerated     Boolean   @default(false)
  isActive          Boolean   @default(true)
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  conversations Conversation[]

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  flow     Flow?     @relation(fields: [flowId], references: [id], onDelete: SetNull)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([campaignId])
  @@index([token])
  @@index([campaignContactId])
  @@index([tenantId, isActive])
}

/// In-app notification, e.g. "a new lead was captured".
model Notification {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String?
  type       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, readAt])
  @@index([createdAt])
}

/// Password reset tokens. Previously flattened onto two User columns, which
/// allowed only one live token per user and left no record of issuance.
/// Only the SHA-256 hash of the token is stored.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A short redirect for a campaign link.
///
/// SMS campaigns are billed per 160-character segment, and a full tracking URL
/// can consume most of a segment on its own. These are served from the
/// platform's own domain (or the workspace's custom domain), so no third-party
/// shortener and no extra cost is involved.
model ShortLink {
  id                String    @id @default(cuid())
  tenantId          String
  /// The public path segment, e.g. "aB3x9" in https://host/s/aB3x9
  code              String    @unique
  targetUrl         String
  campaignId        String?
  campaignContactId String?
  clickCount        Int       @default(0)
  lastClickAt       DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([campaignId])
  @@index([code])
}

/// A frozen copy of a generated report.
///
/// A report emailed to a client in March must still say in June exactly what it
/// said in March. Re-running the query would quietly restate history as data
/// arrives late, conversations close, or leads change status, so the numbers are
/// stored rather than recomputed.
model ReportSnapshot {
  id            String   @id @default(cuid())
  tenantId      String
  reportType    String
  rangeStart    DateTime
  rangeEnd      DateTime
  /// JSON: the exact filters the user had applied when they generated it.
  filters       String?
  /// JSON: the computed metrics, verbatim.
  metrics       String
  /// JSON: the rule-based insights as they read at generation time.
  insights      String?
  generatedById String?
  generatedAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, generatedAt])
  @@index([tenantId, reportType])
}

/// Pre-aggregated daily counters, so opening a dashboard does not scan every
/// event ever recorded.
///
/// `scope` is a string key ("tenant", "flow:<id>", "campaign:<id>") rather than
/// nullable flowId/campaignId columns, because Postgres treats NULLs in a
/// unique constraint as distinct — nullable dimensions would let duplicate
/// rows accumulate for the same day and silently double every total.
model DailyAnalytics {
  id                    String   @id @default(cuid())
  tenantId              String
  day                   DateTime
  scope                 String   @default("tenant")
  visitors              Int      @default(0)
  uniqueVisitors        Int      @default(0)
  chatbotOpens          Int      @default(0)
  conversationsStarted  Int      @default(0)
  conversationsComplete Int      @default(0)
  messages              Int      @default(0)
  formsStarted          Int      @default(0)
  formsCompleted        Int      @default(0)
  leads                 Int      @default(0)
  linkOpens             Int      @default(0)
  uniqueLinkOpens       Int      @default(0)
  aiRequests            Int      @default(0)
  handoffs              Int      @default(0)
  computedAt            DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, day, scope])
  @@index([tenantId, day])
  @@index([tenantId, scope, day])
}

/// Where a workspace wants to be told about new leads.
///
/// One row per workspace, so a client's alerts only ever reach that client.
/// Secrets are encrypted at rest with the same helper as AI keys and SMTP
/// passwords; nothing here is ever returned to a browser in the clear.
model NotificationSetting {
  id       String @id @default(cuid())
  tenantId String @unique

  /// Master switch. Off means no channel fires, whatever else is configured.
  leadAlerts Boolean @default(true)

  telegramEnabled  Boolean @default(false)
  /// Encrypted. Each workspace uses its own bot so one client's token can
  /// never be used to message another's chat.
  telegramBotToken String?
  telegramChatId   String?

  emailEnabled Boolean @default(false)
  /// Comma-separated; a sales team usually wants more than one address.
  emailTo      String?

  webPushEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A browser that has agreed to receive push notifications.
///
/// Tied to both the workspace and the person, so revoking one user's access
/// stops their device without affecting colleagues.
model PushSubscription {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  /// The browser's own endpoint URL, unique per device+browser.
  endpoint String @unique
  p256dh   String
  auth     String

  userAgent String?
  createdAt DateTime  @default(now())
  lastUsedAt DateTime @default(now())
  /// Set when the browser reports the subscription is gone, so a dead device
  /// stops being retried on every lead.
  failedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, failedAt])
}
